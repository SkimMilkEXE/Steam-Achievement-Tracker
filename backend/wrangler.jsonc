{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "api.skimmilkexe.dev",
      "zone_name": "skimmilkexe.dev",
      "custom_domain": true
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
