<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AchievementTracker.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="AchievementTracker.Views.GameDetailView"
             x:DataType="vm:GameDetailViewModel">

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="&lt; Back" Command="{Binding BackCommand}" />
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
            <TextBlock Text="{Binding GameName}" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="IndianRed"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Top" Text="Loading..." IsVisible="{Binding IsLoading}" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                    IsVisible="{Binding CompletionText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding CompletionFraction}" Width="200" Height="8" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CompletionText}" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" />
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search achievements..." Margin="0,0,8,0" />
        </DockPanel>

        <ListBox ItemsSource="{Binding Achievements}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AchievementListItem">
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="0,8">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image Source="{Binding Icon}" Width="40" Height="40" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock Text="{Binding GlobalPercentText}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="Hunt" IsChecked="{Binding Pinned}" Margin="16,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="52,0,0,0">
                                <TextBox Text="{Binding Note}" PlaceholderText="Add a note..." Width="320" />
                                <Button Content="Save" Command="{Binding SaveNoteCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Checklist}" Margin="52,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <CheckBox IsChecked="{Binding Checked}" Content="{Binding Text}" />
                                            <Button Content="Remove" Command="{Binding DeleteCommand}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="52,0,0,0">
                                <TextBox Text="{Binding NewChecklistItemText}" PlaceholderText="Add a step..." Width="240" />
                                <Button Content="Add" Command="{Binding AddChecklistItemCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
