<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AchievementTracker.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="AchievementTracker.Views.GameDetailView"
             x:DataType="vm:GameDetailViewModel">

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="&lt; Back" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding GameName}" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="IndianRed"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Top" Text="Loading..." IsVisible="{Binding IsLoading}" Margin="0,0,0,12" />

        <ListBox ItemsSource="{Binding Achievements}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AchievementListItem">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="4">
                        <Image Source="{Binding Icon}" Width="40" Height="40" />
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding GlobalPercentText}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
