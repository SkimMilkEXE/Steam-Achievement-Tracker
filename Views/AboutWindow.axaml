<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AchievementTracker.Views.AboutWindow"
        x:DataType="local:AboutWindow"
        xmlns:local="using:AchievementTracker.Views"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="380" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="About Steam Hunter">

    <StackPanel Margin="28" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="76" Height="76" CornerRadius="38" ClipToBounds="True"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2"
                HorizontalAlignment="Center"
                BoxShadow="0 0 20 2 #408FC0F5">
            <Image Source="/Assets/SkimProfile.png" Stretch="UniformToFill"
                   Width="140" Height="140"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>

        <TextBlock Text="Steam Hunter" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Version}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,-8,0,0" />
        <TextBlock Text="Track Steam achievement hunting, notes, and checklists."
                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />

        <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>

</Window>
